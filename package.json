{
  "scripts": {
    "format": "bun run format:rs && bun run format:ts",
    "format:ts": "bun run --cwd frontend prettier --write \"../**/*.{ts,tsx,js,jsx,json,md,css}\" --ignore-path ../.gitignore",
    "format:rs": "cargo fmt --all",
    "dev:config": "cargo run -p gateway -- -c examples/dev.certus.config.yaml",
    "dev:servers": "bun run --cwd test dev --http1 3000,3001,3002,3005,3006 --http2 3003,3004 --https1 3007,3008 --https2 3009,3010 --log --jiq 3005,3006",
    "dev:test": "bun dev:config & bun dev:servers & wait",
    "bench": "cargo bench -p gateway"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7"
  }
}
